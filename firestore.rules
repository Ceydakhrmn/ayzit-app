rules_version = '2';

// ============================================================
// Lunora Firestore security rules
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isVerified() {
      return isAuth() && request.auth.token.email_verified == true;
    }

    function nonEmptyString(val) {
      return val is string && val.size() > 0 && val.size() <= 5000;
    }

    // ── Users ──────────────────────────────────────────────
    // Kullanıcı dokümanı e-posta + appMode (sağlık durumu) gibi hassas
    // veri içerir. Feed yazar bilgisini post'larda denormalize ettiği için
    // (authorUsername / authorAvatarSeed) başka kullanıcının bu dokümanı
    // okumasına gerek yoktur → sadece sahibi okuyabilir/yazabilir.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);

      match /fcmTokens/{deviceId} {
        allow read, write: if isOwner(uid);
      }

      match /cycleNotes/{dateKey} {
        allow read, write: if isOwner(uid);
      }

      match /cycleHistory/{id} {
        allow read, write: if isOwner(uid);
      }

      match /waterIntake/{dateKey} {
        allow read, write: if isOwner(uid);
      }

      match /cycleMoods/{dateKey} {
        allow read, write: if isOwner(uid);
      }

      match /appointments/{id} {
        allow read, write: if isOwner(uid);
      }

      // ── Etkinlik (zil listesi): paylaşımına gelen yorum / beğeni ──
      // Yalnızca sahibi okur. Kaydı, yorumu ya da beğeniyi yapan kişi aynı
      // işlem içinde yazar; kural bu yorumun / beğeninin gerçekten var
      // olduğunu, paylaşımın bu kullanıcıya ait olduğunu ve kullanıcı adının
      // yazanın kendisi olduğunu doğrular (sahte bildirim gönderilemez).
      // `pushed` alanını Apps Script (IAM yetkisiyle, kurallar dışında)
      // günceller.
      match /activity/{activityId} {
        allow read: if isOwner(uid);

        // Sahibi yalnızca okundu işaretleyebilir.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read'])
          && request.resource.data.read is bool;

        // Sahibi silebilir; yapan kişi de beğeniyi geri alınca / yorumu
        // silince kendi kaydını siler (kayıt yoksa silme zararsızdır).
        allow delete: if isOwner(uid)
          || (isAuth() && (resource == null
                           || resource.data.actorId == request.auth.uid));

        allow create: if isAuth()
          && request.auth.uid != uid
          && request.resource.data.keys().hasOnly([
               'type', 'actorId', 'actorUsername', 'postId', 'commentId',
               'text', 'createdAt', 'read', 'pushed'])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.pushed == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.postId is string
          && get(/databases/$(database)/documents/posts/$(request.resource.data.postId))
               .data.authorId == uid
          && request.resource.data.actorUsername is string
          && get(/databases/$(database)/documents/usernames/$(request.resource.data.actorUsername))
               .data.uid == request.auth.uid
          && (
            (request.resource.data.type == 'like'
              && activityId == 'like_' + request.resource.data.postId + '_' + request.auth.uid
              && existsAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/likes/$(request.auth.uid)))
            || (request.resource.data.type == 'comment'
              && request.resource.data.commentId is string
              && activityId == 'comment_' + request.resource.data.commentId
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 200
              && getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId))
                   .data.authorId == request.auth.uid)
          );
      }
    }

    // ── Usernames (unique reservation) ─────────────────────
    match /usernames/{username} {
      // Kayıt sırasında (giriş yapılmadan) tek bir kullanıcı adının
      // müsaitliği kontrol edildiği için `get` herkese açık. Ancak `list`
      // kapalı — kimse tüm username→uid tablosunu topluca dökemez.
      allow get: if true;
      allow list: if false;
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth()
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── Posts ──────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuth();

      allow create: if isVerified()
        && request.resource.data.authorId == request.auth.uid
        && nonEmptyString(request.resource.data.content)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.hidden == false;

      // Author can edit content; any auth user can bump like/comment counts.
      allow update: if isAuth()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.hidden == resource.data.hidden
        && (
          // Case A: author editing own content (counts must stay the same)
          (isOwner(resource.data.authorId)
            && nonEmptyString(request.resource.data.content)
            && request.resource.data.likeCount == resource.data.likeCount
            && request.resource.data.commentCount == resource.data.commentCount)
          // Case B: any auth user may change ONLY the counters, and only by
          // ±1 at a time (matches the client's FieldValue.increment(±1)).
          // hasOnly() guarantees content, authorUsername, authorAvatarSeed,
          // edited, updatedAt etc. cannot be tampered with here.
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likeCount', 'commentCount'])
            && request.resource.data.likeCount >= resource.data.likeCount - 1
            && request.resource.data.likeCount <= resource.data.likeCount + 1
            && request.resource.data.commentCount >= resource.data.commentCount - 1
            && request.resource.data.commentCount <= resource.data.commentCount + 1
          )
        );

      allow delete: if isOwner(resource.data.authorId);

      // ── Post likes (one doc per liking user) ─────────────
      match /likes/{uid} {
        allow read: if isAuth();
        allow create: if isOwner(uid);
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      // ── Post comments (max 2 levels, enforced client-side) ─
      match /comments/{commentId} {
        allow read: if isAuth();

        allow create: if isAuth()
          && request.resource.data.authorId == request.auth.uid
          && nonEmptyString(request.resource.data.content);

        allow delete: if isOwner(resource.data.authorId);

        allow update: if false;
      }
    }

    // ── Reports (write-only for authed users; read is admin-only) ──
    match /reports/{reportId} {
      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'comment']
        && request.resource.data.reason in [
             'spam', 'harassment', 'inappropriate', 'hate', 'other'
           ];
      allow read, update, delete: if false;
    }

    // ── Config (profanity list etc.) ───────────────────────
    match /config/{doc} {
      allow read: if isAuth();
      allow write: if false;
    }
  }
}
